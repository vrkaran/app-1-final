rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role in [
          'SUPER_ADMIN',
          'ADMIN',
          'OPERATIONS_MANAGER',
          'SALES_MANAGER',
          'TEAM_LEADER',
          'BDE',
          'INSTALLATION_ENGINEER',
          'SERVICE_ENGINEER'
        ] ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@(hbxsolar\\.com|purvanchalsolar\\.in|hbx\\.internal)'))
      );
    }

    function isServerTimestamp(ts) {
      return ts == request.time || (ts is timestamp && ts <= request.time);
    }

    function isValidRole(role) {
      return role in [
        'SUPER_ADMIN',
        'ADMIN',
        'OPERATIONS_MANAGER',
        'SALES_MANAGER',
        'TEAM_LEADER',
        'BDE',
        'INSTALLATION_ENGINEER',
        'SERVICE_ENGINEER',
        'PARTNER',
        'CUSTOMER'
      ];
    }

    function isValidStatus(status) {
      return status in ['ACTIVE', 'PENDING_APPROVAL', 'SUSPENDED', 'INACTIVE'];
    }

    function isValidUser(data) {
      return data.size() >= 10 &&
        data.uid is string && data.uid.size() > 0 &&
        data.fullName is string && data.fullName.size() > 0 &&
        data.email is string &&
        data.phone is string &&
        isValidRole(data.role) &&
        data.employeeId is string &&
        data.territoryId is string &&
        isValidStatus(data.accountStatus) &&
        isServerTimestamp(data.createdAt) &&
        isServerTimestamp(data.updatedAt);
    }

    function isValidLead(data) {
      return data.size() >= 11 &&
        data.id is string && data.id.size() > 0 &&
        data.name is string && data.name.size() > 0 &&
        data.phone is string && data.phone.size() > 0 &&
        data.village is string &&
        data.stage is string &&
        data.priority is string &&
        data.capacity is string &&
        data.systemType is string &&
        data.userId is string && data.userId == request.auth.uid &&
        isServerTimestamp(data.createdAt) &&
        isServerTimestamp(data.updatedAt);
    }

    function isValidPayment(data) {
      return data.size() >= 9 &&
        data.receiptId is string && data.receiptId.size() > 0 &&
        data.customerName is string && data.customerName.size() > 0 &&
        data.consumerId is string &&
        data.amount is number && data.amount > 0 &&
        data.method is string &&
        data.referenceNo is string &&
        data.status in ['Verified', 'Pending Verification', 'Rejected'] &&
        data.userId is string && data.userId == request.auth.uid &&
        isServerTimestamp(data.createdAt);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isStaff() || isOwner(userId);

      allow create: if isOwner(userId) &&
        isValidUser(request.resource.data) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role in ['BDE', 'CUSTOMER', 'INSTALLATION_ENGINEER', 'PARTNER']);

      allow update: if isOwner(userId) &&
        isValidUser(request.resource.data) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Leads Collection
    match /leads/{leadId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated() &&
        isValidLead(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
        isValidLead(request.resource.data) &&
        (resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid || isStaff());

      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.consumerId == request.auth.uid));

      allow create: if isAuthenticated() &&
        isValidPayment(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
        isValidPayment(request.resource.data) &&
        (resource.data.userId == request.auth.uid || isStaff());

      allow delete: if false;
    }

    // Documents Metadata Collection
    match /documents/{documentId} {
      allow read: if isStaff() || (
        isAuthenticated() && (
          resource.data.parentEntityId == request.auth.uid ||
          resource.data.businessId == request.auth.uid ||
          resource.data.uploadedByUid == request.auth.uid
        )
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uploadedByUid == request.auth.uid &&
        request.resource.data.documentId == documentId &&
        isServerTimestamp(request.resource.data.uploadedAt);

      allow update: if isAuthenticated() &&
        (resource.data.uploadedByUid == request.auth.uid || isStaff()) &&
        // Prevent metadata forgery / ownership hijacking
        request.resource.data.uploadedByUid == resource.data.uploadedByUid &&
        request.resource.data.documentId == resource.data.documentId &&
        request.resource.data.storagePath == resource.data.storagePath &&
        request.resource.data.createdAt == resource.data.createdAt;

      // Enforce zero-loss soft deletion
      allow delete: if false;
    }

    // Document Audit Logs (Immutable Append-Only)
    match /document_audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthenticated() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.auditId == logId &&
        isServerTimestamp(request.resource.data.timestamp);
      allow update, delete: if false;
    }
  }
}

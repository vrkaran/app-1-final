rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // SEC-07: Trusted server-assigned Custom Claims ONLY (Domain-only regex matching completely removed)
    function isStaff() {
      return isAuthenticated() && (
        'role' in request.auth.token &&
        request.auth.token.role in [
          'SUPER_ADMIN',
          'ADMIN',
          'OPERATIONS_MANAGER',
          'SALES_MANAGER',
          'TEAM_LEADER',
          'BDE',
          'INSTALLATION_ENGINEER',
          'SERVICE_ENGINEER'
        ]
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        'role' in request.auth.token &&
        request.auth.token.role in ['SUPER_ADMIN', 'ADMIN', 'OPERATIONS_MANAGER']
      );
    }

    // SEC-08: Backend enforcement of user account status
    function isCallerActive() {
      return isAuthenticated() &&
        (!('accountStatus' in request.auth.token) || (request.auth.token.accountStatus != 'SUSPENDED' && request.auth.token.accountStatus != 'INACTIVE')) &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         ('accountStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus != 'SUSPENDED' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus != 'INACTIVE'));
    }









    function isServerTimestamp(ts) {
      return ts == request.time || (ts is timestamp && ts <= request.time);
    }

    function isValidRole(role) {
      return role in [
        'SUPER_ADMIN',
        'ADMIN',
        'OPERATIONS_MANAGER',
        'SALES_MANAGER',
        'TEAM_LEADER',
        'BDE',
        'INSTALLATION_ENGINEER',
        'SERVICE_ENGINEER',
        'PARTNER',
        'CUSTOMER'
      ];
    }

    function isValidStatus(status) {
      return status in ['ACTIVE', 'PENDING_APPROVAL', 'SUSPENDED', 'INACTIVE'];
    }

    function isValidUser(data) {
      return data.size() >= 10 &&
        data.uid is string && data.uid.size() > 0 &&
        data.fullName is string && data.fullName.size() > 0 &&
        data.email is string &&
        data.phone is string &&
        isValidRole(data.role) &&
        data.employeeId is string &&
        data.territoryId is string &&
        isValidStatus(data.accountStatus) &&
        isServerTimestamp(data.createdAt) &&
        isServerTimestamp(data.updatedAt);
    }

    function isValidLead(data) {
      return data.size() >= 11 &&
        data.id is string && data.id.size() > 0 &&
        data.name is string && data.name.size() > 0 &&
        data.phone is string && data.phone.size() > 0 &&
        data.village is string &&
        data.stage is string &&
        data.priority is string &&
        data.capacity is string &&
        data.systemType is string &&
        data.userId is string && data.userId == request.auth.uid &&
        isServerTimestamp(data.createdAt) &&
        isServerTimestamp(data.updatedAt);
    }

    function isValidPayment(data) {
      return data.size() >= 9 &&
        data.receiptId is string && data.receiptId.size() > 0 &&
        data.customerName is string && data.customerName.size() > 0 &&
        data.consumerId is string &&
        data.amount is number && data.amount > 0 &&
        data.method is string &&
        data.referenceNo is string &&
        data.status in ['Verified', 'Pending Verification', 'Rejected'] &&
        data.userId is string && data.userId == request.auth.uid &&
        isServerTimestamp(data.createdAt);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // SEC-08: Suspended/inactive users cannot read other profiles; can read own profile if authenticated
      allow read: if isStaff() || isOwner(userId);

      // New users self-register as CUSTOMER or BDE draft
      allow create: if isOwner(userId) &&
        isValidUser(request.resource.data) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role in ['BDE', 'CUSTOMER', 'INSTALLATION_ENGINEER', 'PARTNER']);

      // SEC-08: Users cannot change their own role or accountStatus
      // Administrators can update other users (e.g. suspend or activate)
      allow update: if (
          isOwner(userId) &&
          isValidUser(request.resource.data) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.accountStatus == resource.data.accountStatus &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt
        ) || (
          isAdmin() &&
          isValidUser(request.resource.data) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt
        );

      allow delete: if false;
    }

    // Leads Collection (SEC-08: Protected by isCallerActive())
    match /leads/{leadId} {
      allow read: if isCallerActive() && (isStaff() || resource.data.userId == request.auth.uid);

      allow create: if isCallerActive() &&
        isValidLead(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isCallerActive() &&
        isValidLead(request.resource.data) &&
        (resource.data.userId == request.auth.uid || resource.data.assignedToUid == request.auth.uid || isStaff());

      allow delete: if isCallerActive() && (resource.data.userId == request.auth.uid || isStaff());
    }

    // Payments Collection (SEC-08: Protected by isCallerActive())
    match /payments/{paymentId} {
      allow read: if isCallerActive() && (isStaff() || resource.data.userId == request.auth.uid || resource.data.consumerId == request.auth.uid);

      allow create: if isCallerActive() &&
        isValidPayment(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isCallerActive() &&
        isValidPayment(request.resource.data) &&
        (resource.data.userId == request.auth.uid || isStaff());

      allow delete: if false;
    }

    // Documents Metadata Collection (SEC-08: Protected by isCallerActive())
    match /documents/{documentId} {
      allow read: if isCallerActive() && (
        isStaff() || (
          resource.data.parentEntityId == request.auth.uid ||
          resource.data.businessId == request.auth.uid ||
          resource.data.uploadedByUid == request.auth.uid
        )
      );

      allow create: if isCallerActive() &&
        request.resource.data.uploadedByUid == request.auth.uid &&
        request.resource.data.documentId == documentId &&
        isServerTimestamp(request.resource.data.uploadedAt);

      allow update: if isCallerActive() &&
        (resource.data.uploadedByUid == request.auth.uid || isStaff()) &&
        // Prevent metadata forgery / ownership hijacking
        request.resource.data.uploadedByUid == resource.data.uploadedByUid &&
        request.resource.data.documentId == resource.data.documentId &&
        request.resource.data.storagePath == resource.data.storagePath &&
        request.resource.data.createdAt == resource.data.createdAt;

      // Enforce zero-loss soft deletion
      allow delete: if false;
    }

    // Document Audit Logs (Immutable Append-Only)
    match /document_audit_logs/{logId} {
      allow read: if isCallerActive() && isStaff();
      allow create: if isCallerActive() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.auditId == logId &&
        isServerTimestamp(request.resource.data.timestamp);
      allow update, delete: if false;
    }
    // Security Audit Logs (Written exclusively by Firebase Admin SDK; Read-only for Administrators)
    match /security_audit_logs/{logId} {
      allow read: if isCallerActive() && isAdmin();
      allow write: if false; // Only Firebase Admin SDK bypass can write
    }
  }
}

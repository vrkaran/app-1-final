rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isCustomerOwner(customerId) {
      return isAuthenticated() && request.auth.uid == customerId;
    }

    // SEC-07: Trusted server-assigned Custom Claims ONLY (Domain-only regex matching completely removed)
    function isStaff() {
      return isAuthenticated() && (
        'role' in request.auth.token &&
        request.auth.token.role in [
          'SUPER_ADMIN',
          'ADMIN',
          'OPERATIONS_MANAGER',
          'SALES_MANAGER',
          'TEAM_LEADER',
          'BDE',
          'INSTALLATION_ENGINEER',
          'SERVICE_ENGINEER'
        ]
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        'role' in request.auth.token &&
        request.auth.token.role in ['SUPER_ADMIN', 'ADMIN', 'OPERATIONS_MANAGER']
      );
    }

    // SEC-08: Suspended / Inactive token check
    // Tokens with status SUSPENDED or INACTIVE are rejected from storage operations
    function isTokenActive() {
      return isAuthenticated() &&
        (!('accountStatus' in request.auth.token) ||
         (request.auth.token.accountStatus != 'SUSPENDED' && request.auth.token.accountStatus != 'INACTIVE'));
    }

    function isValidImageOrPdf() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|text/.*|application/msword|application/vnd.openxmlformats-officedocument.*');
    }

    function isValidVideo() {
      return request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // 1. User Profiles
    match /users/{userId}/profile/{fileName} {
      allow read: if isTokenActive();
      allow write: if isTokenActive() && (request.auth.uid == userId) && isValidImageOrPdf();
      allow delete: if false;
    }

    // 2. Customer Documents (KYC, Electricity Bills, Agreements)
    match /customers/{customerId}/{folder}/{fileName} {
      allow read: if isTokenActive() && (isCustomerOwner(customerId) || isStaff());
      allow write: if isTokenActive() && (isCustomerOwner(customerId) || isStaff()) && isValidImageOrPdf()
        && folder in ['kyc', 'electricity-bills', 'agreements'];
      allow delete: if false;
    }

    // 3. Leads Documents (Staff or Customer Lead Owner)
    match /leads/{leadId}/documents/{fileName} {
      allow read: if isTokenActive() && (isStaff() || isCustomerOwner(leadId));
      allow write: if isTokenActive() && (isStaff() || isCustomerOwner(leadId)) && isValidImageOrPdf();
      allow delete: if false;
    }

    // 4. Site Surveys (Photos & Videos)
    match /site-surveys/{surveyId}/photos/{fileName} {
      allow read: if isTokenActive() && (isStaff() || isCustomerOwner(surveyId));
      allow write: if isTokenActive() && isStaff() && isValidImageOrPdf();
      allow delete: if false;
    }
    match /site-surveys/{surveyId}/videos/{fileName} {
      allow read: if isTokenActive() && (isStaff() || isCustomerOwner(surveyId));
      allow write: if isTokenActive() && isStaff() && isValidVideo();
      allow delete: if false;
    }

    // 5. Projects (Site Photos, Installation Evidence, Inspection Reports, Completion Certificates, Warranty Documents)
    match /projects/{projectId}/{folder}/{fileName} {
      allow read: if isTokenActive() && (isStaff() || isCustomerOwner(projectId));
      allow write: if isTokenActive() && isStaff() && isValidImageOrPdf()
        && folder in ['site-photos', 'installation-evidence', 'inspection-reports', 'completion-certificates', 'warranty-documents'];
      allow delete: if false;
    }

    // 6. Quotations (PDFs)
    match /quotations/{quotationId}/pdf/{fileName} {
      allow read: if isTokenActive() && (isStaff() || isCustomerOwner(quotationId));
      allow write: if isTokenActive() && isStaff() && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf');
      allow delete: if false;
    }

    // 7. Payments (Receipts, Proof, UPI screenshots, Cheque deposit slips)
    match /payments/{paymentId}/{folder}/{fileName} {
      allow read: if isTokenActive() && (isStaff() || isCustomerOwner(paymentId) || isAuthenticated());
      allow write: if isTokenActive() && (isStaff() || isCustomerOwner(paymentId) || isAuthenticated()) && isValidImageOrPdf()
        && folder in ['receipts', 'proof'];
      allow delete: if false;
    }

    // 8. Service Requests
    match /service-requests/{serviceRequestId}/attachments/{fileName} {
      allow read: if isTokenActive() && (isStaff() || isCustomerOwner(serviceRequestId));
      allow write: if isTokenActive() && (isStaff() || isCustomerOwner(serviceRequestId)) && isValidImageOrPdf();
      allow delete: if false;
    }

    // 9. Company Assets (Logos, Templates)
    match /company-assets/{fileName} {
      allow read: if isTokenActive();
      allow write: if false; // Only deploy via CI/Console
      allow delete: if false;
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
